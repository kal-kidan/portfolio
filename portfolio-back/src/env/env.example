# Copy to env.development / env.production (gitignored).
# Production: also sync to Cloud Run via `pnpm cloudrun:env`.

NODE_ENV=development
PORT=3000
APP_NAME=portfolio-back
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=portfolio

# JWT / auth (wire modules when implementing features)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# AI (optional — add when needed)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_ENABLE_SEARCH=false
AI_TIMEOUT_MS=60000
AI_RETRIES=2
AI_RETRY_DELAY_MS=1000

# Chat AI tuning (optional)
CHAT_AI_TIMEOUT_MS=
CHAT_AI_RETRIES=
CHAT_AI_RETRY_DELAY_MS=

# Cloudinary (optional)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Billing — Polar (optional)
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_API_BASE=https://api.polar.sh
POLAR_WEBHOOK_SECRET=

# Logging
LOG_LEVEL=info
